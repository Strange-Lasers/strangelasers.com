<!doctype html>
<html{% block htmlAttributes %}{% endblock %} lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ themeColor }}">
    {% if noindex | default(false) %}<meta name="robots" content="noindex">{% endif %}
    <meta name="description" content="{% block description %}{{ site.name }} {{ site.description }}{% endblock %}">
    <title>{% block pageTitle %}{{ title }} | {{ site.name }}{% endblock %}</title>
    <link rel="canonical" href="{{ page.url | canonicalUrl(site.url) }}">
    {% block head %}{% endblock %}
    <link rel="icon" href="{{ assetPrefix }}mark.svg?v=brand-spectrum" type="image/svg+xml">
    {% block manifest %}{% endblock %}
    <script src="{{ assetPrefix }}site-init.js"></script>
    <link rel="stylesheet" href="{{ assetPrefix }}palette.css?v={{ 'palette.css' | assetVersion }}">
    {% block styles %}{% endblock %}
  </head>
  <body{% block bodyAttributes %}{% endblock %}>
    {% block content %}{% endblock %}
    {% block scripts %}{% endblock %}
  </body>
</html>
