      <canvas
        class="edge-smoke"
        data-edge-smoke
        aria-hidden="true"
      ></canvas>

      <aside
        class="smoke-tuner"
        data-smoke-tuner
        aria-label="Visual tuning"
        hidden
      >
        <header
          class="smoke-tuner__header"
          data-smoke-tuner-drag-handle
        >
          <div class="smoke-tuner__title">
            <h2>Visual tuning</h2>
            <button
              class="smoke-tuner__info-button"
              type="button"
              aria-label="Visual tuning instructions"
              aria-describedby="smoke-tuner-tooltip"
            >
              i
            </button>
            <span
              id="smoke-tuner-tooltip"
              class="smoke-tuner__tooltip"
              role="tooltip"
            >Drag this panel by its header and resize it from the lower-right corner. Collapse either section to save space. Defaults sit at each slider's center. Most multipliers span 0.01x to 100.00x; drifted density reaches 0.001x and inward reach reaches 1000.00x. Edge density controls coverage at the frame. Lower drifted density makes deep mist less frequent, while higher inward reach makes it extend farther. Type exact values in the boxes.</span>
          </div>
          <button
            class="smoke-tuner__quiet-button"
            type="button"
            data-smoke-tuner-collapse
            aria-controls="visual-tuner-body"
            aria-expanded="true"
          >
            Hide
          </button>
        </header>
        <div
          id="visual-tuner-body"
          class="smoke-tuner__body"
          data-smoke-tuner-body
        >
          <details class="smoke-tuner__section" open>
            <summary>Center animation</summary>
            <div class="smoke-tuner__section-body">
              <div class="smoke-tuner__presets">
                <span class="smoke-tuner__presets-heading">
                  Presets
                </span>
                <div
                  class="smoke-tuner__preset-list"
                  data-speed-presets
                  role="group"
                  aria-label="Rotation speed presets"
                ></div>
              </div>
              <div class="smoke-tuner__control">
                <span class="smoke-tuner__control-heading">
                  <label for="rotation-speed-range">
                    Rotation speed
                  </label>
                  <span class="smoke-tuner__value-editor">
                    <input
                      id="rotation-speed-number"
                      class="smoke-tuner__value-input"
                      data-speed-number
                      type="number"
                      min="0.01"
                      max="100"
                      step="0.01"
                      value="1.00"
                      inputmode="decimal"
                      aria-label="Rotation speed exact value"
                    >
                    <span class="smoke-tuner__value-unit">x</span>
                  </span>
                </span>
                <input
                  id="rotation-speed-range"
                  data-speed-range
                  type="range"
                  min="0"
                  max="1000"
                  step="1"
                  value="500"
                  data-rate-min="0.01"
                  data-rate-mid="1"
                  data-rate-max="100"
                  aria-valuetext="1.00x"
                >
              </div>
            </div>
          </details>
          <details class="smoke-tuner__section" open>
            <summary>Smoke</summary>
            <div class="smoke-tuner__section-body">
              <div class="smoke-tuner__presets">
                <span class="smoke-tuner__presets-heading">
                  Presets
                </span>
                <div
                  class="smoke-tuner__preset-list"
                  data-smoke-tuner-presets
                  role="group"
                  aria-label="Smoke presets"
                ></div>
              </div>
              <div
                class="smoke-tuner__controls"
                data-smoke-tuner-controls
              ></div>
            </div>
          </details>
          <div class="smoke-tuner__actions">
            <button type="button" data-visual-tuner-reset>
              Reset all
            </button>
            <button type="button" data-smoke-tuner-copy>
              Copy tuning link
            </button>
          </div>
          <output
            class="smoke-tuner__status"
            data-smoke-tuner-status
            aria-live="polite"
          ></output>
        </div>
      </aside>
